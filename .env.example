PORT=8080
# Put this on a fast local SSD with at least several GB free per concurrent job.
DATA_PATH=./data
# Set a private owner key with: openssl rand -hex 32
# Add the result after the equals sign; keep .env out of Git.
ADMIN_TOKEN=
# For public HTTPS on a VPS with compose.oracle.yaml:
# SITE_DOMAIN=example.com
# Optional: increase only after confirming conversion memory usage on your server.
# WORKER_CONCURRENCY=1
